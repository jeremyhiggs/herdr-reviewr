# Rust. Every build dir is target or target-<something> (a cross build like target-xwin, a
# second dir for an A/B bench), and none is ever committed.
/target/
/target-*/
**/*.rs.bk
Cargo.lock.bak

# macOS
.DS_Store

# editor / local
.idea/
.vscode/
*.swp
*.log

# herdr local state (if any lands here during dev)
/.herdr-state/

# Prebuilt binary dropped by herdr/install.sh on `herdr plugin install`
/bin/

# Python bytecode from scripts/
__pycache__/
*.pyc
